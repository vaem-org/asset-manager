{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "./src",
    "paths": {
      "#~/*": ["./src/*"]
    },
    "types": ["node"],
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["src/sandbox.ts"]
}
